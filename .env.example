# Local example: postgresql://postgres:password@localhost:5432/student_os
# For Neon, use the pooled connection string from your Neon project.
DATABASE_URL="postgresql://student_os:student_os@localhost:5432/student_os?schema=public"

# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate a long random value, for example with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Kept for compatibility with NextAuth deployments that still read this name.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
